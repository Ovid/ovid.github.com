#!/usr/bin/env perl

# vim: ft=perl
use lib 'lib';
use strict;
use warnings;
use Getopt::Long;
use PerlX::Maybe;
GetOptions(
    \my %options,
    'release',
    'notest',
    'file=s',
) or die "bad options";

use Ovid::Site;

my $site = Ovid::Site->new(
    release    => $options{release},
    maybe file => $options{file},
);

# A bare die exits with $! or $? when set, which can collide with the
# exit 1 reserved for test failures, so force 255.
eval { $site->build; 1 } or do { warn $@; exit 255 };

exit 0 if $options{notest};

# Propagate test failures; this used to exit 0 whatever prove said.
# -r so t/integration/ and other subdirectories run too.
system( 'prove', '-rl', 't' );
exit( $? == 0 ? 0 : 1 );

__END__

=head1 NAME

rebuild - Rebuilds site

=head1 DESCRIPTION

=over 4

=item * Preprocesses files (such as adding TOCs and TAGS)

=item * Runs C<ttree>

=item * Runs all tests

=item * Rebuilds article pagination

=back

=head1 OPTIONS

=over 4

=item B<--file>

Only build this file.

=item B<--release>

Builds the site for release. This means that the site will be built, along
with the search engine.

=item B<--notest>

Skips running the tests. Not recommended.

=back

=head1 EXIT STATUS

0 when the build succeeds and (unless B<--notest>) every test passes; 1 when
any test fails; 255 when the build itself dies, such as on a Template Toolkit
parse error.
