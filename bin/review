#!/usr/bin/env perl

use v5.40;
use Dancer2;
use Path::Tiny;
use Time::HiRes qw(sleep);
use Getopt::Long qw(GetOptions);
use Pod::Usage   qw(pod2usage);
use open ':std', ':encoding(UTF-8)';

use constant DEFAULT_PORT => 7007;

my $port = DEFAULT_PORT;

# Only consume @ARGV when invoked as a program. The test suite loads this
# file with `do './bin/review'` to get the PSGI app, and in that case @ARGV
# belongs to the test harness — parsing it would swallow prove's own
# switches and abort the run.
unless (caller) {
    GetOptions(
        'port|p=i' => \$port,
        'help|h'   => \my $help,
    ) or pod2usage( -exitval => 2, -verbose => 0 );

    pod2usage( -exitval => 0, -verbose => 1 ) if $help;

    unless ( $port =~ /^[0-9]+$/ && $port >= 1 && $port <= 65535 ) {
        pod2usage(
            -exitval => 2,
            -verbose => 0,
            -message => "--port must be between 1 and 65535, not '$port'\n",
        );
    }
}

# Security: bind to localhost only. Dancer2 defaults to 0.0.0.0, which
# would expose the dev server (including the editor-launch endpoint
# and the static file handler) on every interface. The startup banner
# advertises 127.0.0.1; this is what makes that claim true.
set host => '127.0.0.1';
set port => $port;

# Personal dev server: serve any in-project file the filesystem
# resolves to, except paths containing dot-prefixed segments (.git,
# .env, editor swapfiles) and symlinks pointing outside the project.
my $PROJECT_ROOT        = path('.')->absolute->realpath;
my $ROOT_TEMPLATES_ROOT = $PROJECT_ROOT->child('root')->realpath;

# Tracks the most recent editor child PID across requests so we can
# target it precisely instead of running `pkill -f 'perl bin/launch'`
# (which, with concurrent POSTs, would kill each others' editors).
my $editor_child_pid;

# Set text/html content-type and return the file's UTF-8 content so that
# the `after` hook can inject the dev-tools script into the response.
sub _slurp_html ($path) {
    content_type 'text/html; charset=UTF-8';
    return $path->slurp_utf8;
}

sub _terminate_previous_editor () {
    return unless $editor_child_pid;
    kill 'TERM', $editor_child_pid;
    waitpid $editor_child_pid, 0;
    $editor_child_pid = undef;
}

hook after => sub {
    my $response = shift;

    # Skip delayed responses (like send_file)
    return if $response->isa('Dancer2::Core::Response::Delayed');

    # Only inject into HTML responses
    return
      unless $response->content_type
      && $response->content_type =~ m{text/html};

    my $content = $response->content;

    # Inject dev mode flag and script reference in <head>
    my $injection = q{
    <script>window.DEV_MODE = true;</script>
    <script src="/static/dev-tools.js"></script>
};

    $content =~ s{</head>}{$injection</head>};
    $response->content($content);
};

get '/' => sub {
    my $file = path('index.html')->absolute;
    if ( $file->exists && -f $file ) {
        return _slurp_html($file);
    }
    status 'not_found';
    return '404 - Not Found: index.html';
};

post '/api/launch-editor' => sub {
    my $data = eval { from_json( request->body ) };
    if ( $@ || ref($data) ne 'HASH' ) {
        status 'bad_request';
        return to_json( { error => 'Invalid JSON body' } );
    }

    my $file = $data->{file};

    # Validate file parameter
    unless ($file) {
        status 'bad_request';
        return to_json( { error => 'No file specified' } );
    }

    # Prevent directory traversal
    if ( $file =~ /\.\./ ) {
        status 'bad_request';
        return to_json( { error => 'Invalid file path' } );
    }

    # Reject absolute paths up front — they bypass the project-root
    # scoping below if the file happens to exist.
    if ( path($file)->is_absolute ) {
        status 'bad_request';
        return to_json( { error => 'Absolute paths are not allowed' } );
    }

    # Check file exists - try both .tt and .tt2markdown extensions
    my $path        = path($file);
    my $actual_file = $file;

    if ( !$path->exists ) {

        # Try alternate extension — but only when the original path
        # actually carries a .tt/.tt2markdown extension. Otherwise the
        # fallback re-checks the same path and emits a confusing
        # "File not found: X (also tried X)" error.
        my $alt_file;
        if ( $file =~ /\.tt$/ ) {
            ( $alt_file = $file ) =~ s/\.tt$/.tt2markdown/;
        }
        elsif ( $file =~ /\.tt2markdown$/ ) {
            ( $alt_file = $file ) =~ s/\.tt2markdown$/.tt/;
        }

        if ( defined $alt_file && path($alt_file)->exists ) {
            $path        = path($alt_file);
            $actual_file = $alt_file;
        }
        else {
            status 'not_found';
            my $msg
              = defined $alt_file
              ? "File not found: $file (also tried $alt_file)"
              : "File not found: $file";
            return to_json( { error => $msg } );
        }
    }

    # Security: editor targets must live under `root/`. Resolve the
    # absolute path and confirm it starts with the project's `root/`
    # directory — anything else (db/, lib/, cpanfile, etc.) is rejected.
    my $resolved = eval { $path->realpath };
    if (  !defined $resolved
        || index( "$resolved", "$ROOT_TEMPLATES_ROOT/" ) != 0 )
    {
        status 'forbidden';
        return to_json( { error => 'File is not under root/' } );
    }

    # Decide whether to fork. Default test runs ($ENV{TESTING}) skip
    # the fork entirely. A test that wants to exercise the fork path
    # can opt in via $ENV{OVID_REVIEW_TEST_LAUNCH_CMD} (only honored
    # when TESTING is set), which redirects the exec target to that
    # command — typically `perl -e 'exit 0'` for a clean immediate
    # exit.
    my $launch_cmd = $ENV{TESTING} && $ENV{OVID_REVIEW_TEST_LAUNCH_CMD};
    my $skip_fork  = $ENV{PLACK_TEST_EXTERNALSERVER_URI}
      || ( $ENV{TESTING} && !$launch_cmd );

    unless ($skip_fork) {

        # Replace any previous editor we spawned. Targeted kill avoids
        # racing concurrent /api/launch-editor calls that each pkill
        # the other's freshly spawned child.
        _terminate_previous_editor();

        my $pid = fork();
        if ( !defined $pid ) {
            warn "Failed to fork: $!";
        }
        elsif ( $pid == 0 ) {

            # Child process - launch editor
            # Redirect output to log file for debugging
            open STDOUT, '>>', 'bin_launch.log' or die "Can't open log: $!";
            open STDERR, '>&', \*STDOUT         or die "Can't dup STDOUT: $!";
            if ($launch_cmd) {
                exec( $launch_cmd, '-e', 'exit 0' );
            }
            else {
                exec( 'perl', 'bin/launch', $actual_file );
            }
            exit 1;    # Should never reach here
        }
        else {
            $editor_child_pid = $pid;
        }
    }

    content_type 'application/json';
    return to_json( { success => 1, file => $actual_file } );
};

# Serve static files
get '/**' => sub {
    my ($splat) = splat;
    my @segments = @$splat;

    # Reject any segment starting with '.' (covers '..', '.git', '.env',
    # editor swapfiles, etc.) before any filesystem touch.
    if ( grep {/^\./} @segments ) {
        status 'forbidden';
        return '403 - Forbidden';
    }

    # Empty splat means GET / (handled here, no redirect).
    my $path_str = join( '/', @segments ) || 'index.html';

    # URL → filesystem resolution. Three shapes:
    #   - Trailing slash, e.g. /projects/extraction/  → serve
    #     <path>/index.html
    #   - Extensionless final segment, e.g. /blog/foo → serve
    #     <path>/index.html if <path> is a directory; otherwise
    #     <path>.html (so /blog → blog.html, /projects/extraction →
    #     projects/extraction/index.html).
    #   - Anything with an extension is passed through unchanged.
    my $final_segment = $segments[-1] // '';
    if ( $final_segment eq '' ) {
        $path_str .= 'index.html';
    }
    elsif ( $final_segment !~ /\./ ) {

        # Prefer <path>.html when it exists (so /blog continues to
        # serve blog.html even though blog/ is also a directory).
        # Fall back to <path>/index.html when the directory carries
        # one — that's how /projects/extraction resolves.
        if ( -f path("$path_str.html") ) {
            $path_str .= '.html';
        }
        elsif ( -f path("$path_str/index.html") ) {
            $path_str .= '/index.html';
        }
        else {
            # Neither target exists; keep the .html shape so the 404
            # path below reports a familiar resource name.
            $path_str .= '.html';
        }
    }

    my $file = path($path_str)->absolute;

    # Return file if it exists
    if ( $file->exists && -f $file ) {

        # Defense in depth: confirm the realpath still lies inside the
        # project root (catches symlink trickery).
        my $resolved = eval { $file->realpath };
        if (  !defined $resolved
            || index( "$resolved", "$PROJECT_ROOT/" ) != 0 )
        {
            status 'forbidden';
            return '403 - Forbidden';
        }

        # For HTML files, read and return content directly to allow hook injection
        if ( $path_str =~ /\.html?$/i ) {
            return _slurp_html($file);
        }

        # For other files, use send_file
        else {
            send_file( $file->stringify, system_path => 1 );
        }
    }
    else {
        status 'not_found';
        my $custom = path('404.html');
        if ( $custom->exists && -f $custom ) {
            return _slurp_html($custom);
        }
        # Falls back to plaintext when 404.html hasn't been built yet (fresh checkout).
        return "404 - Not Found: $path_str";
    }
};

# If loaded by tests, return PSGI app
# Otherwise, start the server
if (caller) {
    to_app;
}
else {

    # Print startup message
    say "\n" . "=" x 60;
    say "🚀 Development Server Starting";
    say "=" x 60;
    say "\n📍 URL: http://127.0.0.1:$port/";
    say "\n✨ Features:";
    say "   • Edit button (✏️) appears on every page";
    say "   • Click to launch live editor for current page";
    say "   • Dev tools active (window.DEV_MODE = true)";
    say "\n⏹  Press Ctrl+C to stop the server";
    say "=" x 60 . "\n";

    # Start the server
    start;
}

__END__

=encoding utf-8

=head1 NAME

bin/review - local preview server for the generated site, with dev tools

=head1 SYNOPSIS

    # Serve the built site on the default port
    perl bin/review

    # Serve on a different port when 7007 is already taken
    perl bin/review --port=7008
    perl bin/review -p 7008

    perl bin/review --help

=head1 DESCRIPTION

Serves the generated HTML in the project directory over HTTP so you can
browse the site as it will be published, and injects a development toolbar
that the published files never carry.

Run C<perl bin/rebuild> first: this server reads the build output
(F<articles/>, F<blog/>, F<index.html>, F<static/>), not the templates under
F<root/>. It does not rebuild anything, so changes to F<root/> are invisible
until you rebuild.

Every HTML response gets two script tags injected before C</head>>: one
setting C<window.DEV_MODE>, one loading F</static/dev-tools.js>. That script
draws the pencil (✏️) button in the upper left. Clicking it POSTs to
C</api/launch-editor>, which forks C<bin/launch> for the template behind the
current page. Generated pages with no single source file — tag indexes,
paginated listings — have no template to open and will report an error.

The injection happens in the response, so the files on disk stay clean.
Nothing here runs in production: the published site is static HTML on GitHub
Pages, with no Perl, no Dancer2, and no dev tools.

=head2 URL resolution

Requests map to files three ways:

=over 4

=item * A trailing slash serves F<< <path>/index.html >>.

=item * A final segment with no dot prefers F<< <path>.html >>, falling back
to F<< <path>/index.html >> when the directory has one. So C</blog> serves
F<blog.html>, and C</projects/extraction> serves
F<projects/extraction/index.html>.

=item * Anything carrying an extension is served as named.

=back

Misses serve F<404.html> when it has been built, and a plain-text 404
otherwise.

=head1 OPTIONS

=over 4

=item B<--port>, B<-p> I<PORT>

Port to listen on. Defaults to 7007. Must be between 1 and 65535.

Use this when the default is already taken — including by an earlier copy of
this server that did not shut down. Note that the port is the only thing you
can move: the host is always 127.0.0.1 (see L</SECURITY>).

=item B<--help>, B<-h>

Print this synopsis and the option list, then exit.

=back

=head1 SECURITY

This is a single-user development server and is deliberately permissive: it
serves any file in the project the filesystem resolves to. Two limits are not
negotiable, and both are enforced rather than assumed:

=over 4

=item * B<Bound to 127.0.0.1.> Dancer2 defaults to 0.0.0.0, which would
publish the server — including the editor-launch endpoint — on every
interface, so the host is set explicitly and is not configurable. F<t/dev_server.t>
asserts the binding is present in this file's source.

=item * B<Editor targets must live under F<root/>.> C</api/launch-editor>
rejects absolute paths, paths containing C<..>, and any file whose resolved
realpath falls outside F<root/>, so the editor cannot be pointed at F<db/>,
F<lib/>, or anything else outside the templates.

=back

Path segments beginning with a dot (F<.git>, F<.env>, editor swapfiles) are
refused before any filesystem access, and served files are re-checked after
realpath resolution so a symlink cannot escape the project root.

Do not expose this server beyond your own machine.

=head1 FUNCTIONS

=over 4

=item B<_slurp_html($path)>

Sets the response content type to C<text/html; charset=UTF-8> and returns the
file's decoded UTF-8 content. HTML is returned as a string rather than via
C<send_file> so the C<after> hook can inject the dev-tools scripts —
C<send_file> produces a delayed response the hook skips.

=item B<_terminate_previous_editor()>

Sends C<TERM> to the editor process this server last spawned, if any, and
reaps it. Tracking the child PID lets concurrent C</api/launch-editor>
requests replace only their own editor, instead of C<pkill>-ing each other's.

=back

=head1 ENVIRONMENT

=over 4

=item C<TESTING>

Set by the test suite. Suppresses the fork that would launch an editor.

=item C<OVID_REVIEW_TEST_LAUNCH_CMD>

Honored only when C<TESTING> is set. Redirects the editor C<exec> to the
named command so a test can exercise the fork path without starting a real
editor.

=item C<PLACK_TEST_EXTERNALSERVER_URI>

When set, the editor fork is skipped.

=back

=head1 SEE ALSO

L<bin/rebuild> builds the site this server displays. L<bin/launch> is the live
editor this server spawns.

=head1 AUTHOR

Curtis "Ovid" Poe

=cut
