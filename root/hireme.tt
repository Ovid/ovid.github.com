[%- # /hireme is now /about. GitHub Pages serves static files only and cannot
    # issue a 301, so this stub does the redirect client-side. It deliberately
    # skips include/wrapper.tt: the refresh has to sit in <head>, and there is
    # no reason to load the whole site chrome for a page that is visible for
    # zero milliseconds.
    #
    # Two build-side exclusions go with it, both in Ovid::Site:
    # _is_searchable keeps it out of the search index, and %SITEMAP_SKIP keeps
    # it out of sitemap.xml.
-%]
[%- USE Config -%]
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content="0;url=/about">
  <link rel="canonical" href="[% Config.url %]about">
  <meta name="robots" content="noindex">
  <title>This page has moved</title>
</head>
<body>
  <p>This page has moved to <a href="/about">/about</a>.</p>
</body>
</html>
