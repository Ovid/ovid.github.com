<!DOCTYPE html>
<html lang="en">
<head>
  [%- IF identifier == '404' %]
  <script>
    // GitHub Pages doesn't strip trailing slashes from extensionless
    // URLs: /articles/foo serves foo.html, but /articles/foo/ 404s.
    // When the 404 page loads, check whether the slash-less form
    // exists (HEAD) and redirect there. Body is hidden during the
    // check to avoid flashing 404 content before the redirect.
    (function() {
      var path = location.pathname;
      if (path === '/' || !path.endsWith('/')) return;
      var style = document.createElement('style');
      style.textContent = 'body { visibility: hidden; }';
      document.head.appendChild(style);
      var target = path.replace(/\/+$/, '');
      function reveal() { style.remove(); }
      fetch(target, { method: 'HEAD' }).then(function(r) {
        if (r.ok) {
          location.replace(target + location.search + location.hash);
        } else {
          reveal();
        }
      }).catch(reveal);
    })();
  </script>
  [%- END %]
  <script>
    // Immediate theme application to prevent flash of white
    (function() {
      const theme = localStorage.getItem('theme') || 
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }
    })();
  </script>
  [% USE Ovid; USE Config -%]
  <!-- Google tag (gtag.js) — skipped on localhost so dev browsing doesn't skew stats -->
  <script>
    if (location.hostname === '[% Config.domain %]' || location.hostname.endsWith('.[% Config.domain %]')) {
      const gaTag = document.createElement('script');
      gaTag.async = true;
      gaTag.src = 'https://www.googletagmanager.com/gtag/js?id=[% Config.google_analytics_id %]';
      document.head.appendChild(gaTag);

      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', '[% Config.google_analytics_id %]');
    }
  </script>
  [% IF type == 'articles' OR type == 'blog' %][% USE pager = Pager(type => type) %][% END %]
[%- # One description, shared by <meta name="description"> and og:description.
    # Prefer a `description` set in the page's own preamble, then the
    # description stored alongside the article, and only then the title.
    #
    # The title had been the default for every page, which is close to no
    # description at all: a search engine that finds the description merely
    # restating the title discards it and synthesises a snippet instead.
    # Articles already had a real one -- og:description was reading it -- but
    # <meta name="description"> never used it.
    #
    # `pager` only exists for articles and blog posts. Tag pages set both type
    # and slug, so the old `IF type && slug` guard called this_post on an
    # undefined pager and produced an *empty* og:description on every one of
    # them.
    IF description;
        page_description = description;
    ELSIF pager AND slug;
        page_description = pager.this_post(type, slug).description;
    END;
    page_description = page_description || title;
-%]

  <!-- Facebook -->

  <meta property="fb:app_id" content="329861788447703">
  [% IF facebook %]
  [% # images should be 1200 x 630, but not less than 600 x 315 %]
  <meta property="og:image" content="[% Config.url %]static/images/facebook/[% facebook %]">
  <meta property="og:image:type" content="[% Ovid.image_type(facebook) %]">
  [% IF facebook_alt %]<meta property="og:image:alt" content="[% facebook_alt |html%]">[% END %]
  [% ELSE %]
  <meta property="og:image" content="[% Config.url %]static/images/facebook/ovid-facebook.jpg">
  <meta property="og:image:alt" content="A black and white image of the author, Curtis “Ovid” Poe.">
  [% END %]
  <meta property="og:type" content="article">
  [% IF type && slug %]
  <meta property="og:url" content="[% Config.url %][% type %]/[% slug %]">
  [% ELSIF identifier %]
  <meta property="og:url" content="[% Config.url %][% identifier %]">
  [% ELSE %]
  <meta property="og:url" content="[% Config.url %]">
  [% END %]
  <meta property="og:title" content="[% title |html %]">
  <meta property="og:description" content="[% page_description | html %]">

  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  [% IF canonical_url %]<link rel="canonical" href="[% Config.url %][% canonical_url %]">
  [% ELSIF type && slug %]<link rel="canonical" href="[% Config.url %][% type %]/[% slug %]">
  [% ELSIF identifier %]<link rel="canonical" href="[% Config.url %][% identifier %]">
  [% ELSE %]<link rel="canonical" href="[% Config.url %]">
  [% END %]

  <!-- Basic Page Needs -->
  <meta charset="utf-8">
  <title>[% title | html %]</title>
  <meta name="description" content="[% page_description | html %]">
  <meta name="author" content="Curtis Poe">
  <link rel="alternate" type="application/rss+xml" title="Subscribe to my technical blog" href="[% Config.url %]article.rss">
  <link rel="alternate" type="application/rss+xml" title="Subscribe to my personal blog" href="[% Config.url %]blog.rss">

  <!-- Mobile Specific Metas -->
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- FONT -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,300;1,6..72,400&display=swap" rel="stylesheet">

  <!-- CSS -->
  <link rel="stylesheet" href="/static/css/normalize.css">
  <link rel="stylesheet" href="/static/css/skeleton.css">
  <link rel="stylesheet" href="/static/css/main.css">
  <link rel="stylesheet" href="/static/css/dialog.css">
  <link rel="stylesheet" href="/static/css/image.css">
  <link rel="stylesheet" href="/static/css/collapsible.css">
  <link rel="stylesheet" href="/static/css/dark-mode.css">
  <script src="/static/js/dark-mode.js" defer></script>
  <script src="/static/js/code-scroll.js" defer></script>
  [% IF syntax_highlight -%]
  <link rel="stylesheet" type="text/css" href="/static/css/prism.css"/> 
  [% END -%]
  [% IF mathjax -%]
  <script type="text/x-mathjax-config">
  MathJax.Hub.Config({tex2jax: {inlineMath: [['$','$'], ['\\(','\\)']]}});
  </script>
  <script type="text/javascript" async
  src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.4/MathJax.js?config=TeX-MML-AM_CHTML">
  </script>
  [% END %]

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

  [% IF use_starmap %]
  <!-- starmap controls -->
  <link rel="stylesheet" type="text/css" href="/css/starmap.css"/> 

  <!-- I can almost get rid of this now, thanks to refactoring -->
  <script type="text/javascript" src="/static/js/prototype.js"></script>

  <!-- this is the starmap renderer -->
  <script type="text/javascript" src="/static/js/starmap.js"></script>

  <!-- this is the data for the current starmap -->
  <script type="text/javascript" src="/static/js/sol.js"></script>
  [% END %]

</head>
<body>
[%# Targets the <main> landmark, not the <article> inside it: 39 pages --
    the paginated indexes and the 18 legacy articles -- have no #article,
    so this link was a dead anchor on every one of them. -%]
  <a class="skip-link" href="#content">Skip to content</a>

  <header class="masthead">
    <div class="wrap">
      <div class="masthead-row">
        <a class="wordmark" href="/">Curtis “Ovid” Poe <i>— AI, programming, and prose</i></a>
        <div class="masthead-tools">
[% INCLUDE include/search.tt %]
[% INCLUDE "include/dark-mode.tt" %]
        </div>
      </div>
[% INCLUDE include/links.tt %]
    </div>
  </header>

  <div class="wrap">
[%- IF date;
      dparts = date.split('-');
      dyear  = dparts.0;
      dmonth = dparts.1;
      dday   = dparts.2;
    END;
-%]
    <div class="opener[% IF type == 'blog' %] opener--blog[% END %]">
      <div class="dateblock[% IF date %] is-filled[% END %]">
[%- IF date %]
        <span class="dateblock-year">[% dyear %]</span>
        <span class="dateblock-day"><time datetime="[% date %]">[% dmonth %].[% dday %]</time></span>
[%- END %]
        <span class="dateblock-meta">
[%- IF type == 'articles' %]Articles[% ELSIF type == 'blog' %]Blog[% END %]
[%- IF type == 'articles' or type == 'blog' %]<br><span id="time"></span> min read[% END %]
        </span>
      </div>
      <div class="opener-title">
        <h1>[% title || "No Title Found" %]</h1>
      </div>
    </div>

    <div class="page-body">
      <aside class="marginalia[% IF type == 'articles' or type == 'blog' %] is-filled[% END %]">
[% IF type == 'articles' or type == 'blog' %][% INCLUDE include/tags_for_article.tt type=type slug=slug %][% END %]
      </aside>
[%# The main landmark, so assistive tech can jump past the masthead and nav
    to the content. It wraps .prose rather than the <article> inside it
    because 18 legacy pages include this header directly and never get that
    <article> at all -- putting the landmark here is the one spot that covers
    every page carrying the skip link. -%]
      <main class="prose" id="content">
[% IF type == 'articles' or type == 'blog' %]
[%- # Same prev/next strip as the footer, so readers can move between posts
    # without scrolling to the bottom first. -%]
[% INCLUDE include/pager.tt %]
<hr>
[% END %]
[%- # Site-wide, so it sits outside the articles/blog gate above. Quoted
    # because an unquoted template name containing a hyphen parses as
    # subtraction, and TT dies with "unexpected token (-)". -%]
[% INCLUDE "include/global-message.tt" %]
