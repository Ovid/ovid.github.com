[%- # Primary navigation.
    # Rendered as a single horizontal band. On narrow screens the <details>
    # element collapses it to a "Menu" disclosure -- native HTML, so it works
    # with JavaScript disabled and is keyboard operable for free.
    section = '';
    IF type == 'articles' || ( identifier && identifier.match('^articles') );
        section = 'articles';
    ELSIF type == 'blog' || ( identifier && identifier.match('^blog') );
        section = 'blog';
    ELSIF identifier;
        section = identifier;
    END;

    nav_items = [
        { href => '/',           label => 'Home',       id => 'index'      },
        { href => '/articles',   label => 'Articles',   id => 'articles',  feed => '/article.rss' },
        { href => '/blog',       label => 'Blog',       id => 'blog',      feed => '/blog.rss'    },
        { href => '/projects',   label => 'Projects',   id => 'projects'   },
        { href => '/videos',     label => 'Talks',      id => 'videos'     },
        { href => '/wildagile',  label => 'WildAgile',  id => 'wildagile'  },
        { href => '/paad/',      label => 'Learn PAAD', id => 'paad'       },
        { href => '/about',      label => 'About',      id => 'about'      },
    ];
-%]
<nav class="site-nav" aria-label="Main">
  <details class="nav-disclosure" open>
    <summary class="nav-toggle">Menu</summary>
    <ul class="nav-links">
[%- FOREACH item IN nav_items %]
      <li><a href="[% item.href %]"[% IF section == item.id %] aria-current="page"[% END %]>[% item.label %]</a>
[%- IF item.feed %]<a class="nav-feed" href="[% item.feed %]" aria-label="[% item.label %] RSS feed">RSS</a>[% END %]</li>
[%- END %]
    </ul>
  </details>
</nav>
<script>
  // The list starts open so the links are visible even where CSS cannot force
  // a closed <details> open: Firefox gives a closed one's children no frames at
  // all, and ::details-content only arrived in Firefox 141 -- 140 is the
  // current ESR, so Debian stable and Tor Browser land on the wrong side of it.
  // This collapses it back to the disclosure on narrow screens. Inline, and
  // immediately after the element, so it runs before first paint; a deferred
  // file would flash the whole menu open on mobile. No JS means an expanded
  // nav at every width -- readable, not broken.
  (function() {
    const nav  = document.querySelector('.nav-disclosure');
    const wide = matchMedia('(min-width: 60em)');
    const sync = e => { nav.open = e.matches; };
    sync(wide);
    wide.addEventListener('change', sync);
  })();
</script>
