[% USE Ovid %]
[% USE tags = Ovid.Tags %]
<nav class="tag-cloud" aria-labelledby="tag-cloud-heading">
<h2 class="tag-cloud-heading" id="tag-cloud-heading">Tags</h2>
<ul class="cloud tags-scrollable">
[% FOREACH tag IN tags.tags_by_weight %]
    <li><a href="/tags/[% tag %]" data-weight="[% tags.weight_for_tag(tag) %]">[% tags.name_for_tag(tag) %]</a></li>
[% END %]
</ul>
</nav>
