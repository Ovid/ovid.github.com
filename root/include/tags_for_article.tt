[%
    USE Ovid;
    USE tag_plugin = Ovid.Tags;
    tag_key = type _ "/" _ slug;
    tags    = tag_plugin.tags_for_url(tag_key);
%]
[% IF tags.size %]
<nav class="tag-list" aria-labelledby="tag-list-label">
    <p class="tag-list-label" id="tag-list-label">Tags</p>
    <ul class="inline">
[% FOREACH tag IN tags %]
        <li><a href="/tags/[% tag %]">[% tag_plugin.name_for_tag(tag) %]</a></li>
[% END %]
    </ul>
</nav>
[% END %]
